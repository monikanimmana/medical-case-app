# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=postgresql://support_user:support_pass@localhost:5432/support_agent_db

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Pipeline Configuration
BRAND=placeholder
SAMPLE_SIZE=5000
RANDOM_SEED=42

# Retrieval
TOP_K_SIMILAR=5
SIMILARITY_THRESHOLD=0.5

# Escalation thresholds
CONFIDENCE_THRESHOLD=0.7
GROUNDING_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
